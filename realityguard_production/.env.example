# RealityGuard Production Configuration
# Copy to .env and update with your values

# Application
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-secure-random-string
API_KEY=optional-api-key-for-authentication
APP_NAME=RealityGuard
VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Security
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
MAX_UPLOAD_SIZE=524288000  # 500MB in bytes

# Performance
TARGET_FPS=30
MIN_FPS=24
MAX_FPS=60

# Cache
ENABLE_CACHE=true
L1_CACHE_SIZE=50
L2_CACHE_SIZE=100
L3_CACHE_SIZE=200
CACHE_TTL=3600

# Quality
ENABLE_ADAPTIVE_QUALITY=true
MIN_QUALITY=0.3
MAX_QUALITY=1.0
DEFAULT_QUALITY=0.7

# ML Models
MODEL_PATH=models
YOLO_MODEL=yolov8n-seg.pt
USE_GPU=true
GPU_DEVICE=0

# Processing
DEFAULT_MODE=balanced
ENABLE_PREDICTIVE=true
PREDICTION_WINDOW=5

# Storage
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/realityguard
REDIS_URL=redis://localhost:6379/0

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_HOST=localhost

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
ACCESS_LOG=true
LOG_FILE=logs/realityguard.log

# API
API_PREFIX=/api/v1
ENABLE_DOCS=true
RATE_LIMIT=100

# Video Limits
MAX_VIDEO_DURATION=300
MAX_RESOLUTION=(3840,2160)
SUPPORTED_FORMATS=["mp4","avi","mov","mkv","webm"]

# Docker Database Settings
DB_USER=realityguard
DB_PASSWORD=secure-password-here
DB_NAME=realityguard

# Grafana
GRAFANA_PASSWORD=admin